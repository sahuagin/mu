#!/bin/sh
# emu — "execute mu": a multi-call launcher.
#
# Symlink this script (from the checkout it lives in) into ~/.local/bin under a
# tool's name; invoking that name execs that tool's PREBUILT binary from THIS
# workspace. Everything is derived from $0 — no hardcoded paths, no per-tool
# wrapper scripts:
#
#   basename "$0"      -> WHICH tool   (the invoked symlink name)
#   readlink -f "$0"   -> WHERE I live -> the workspace I was installed from
#
# So a symlink made from a dev checkout tracks that dev tree; one made from a
# main checkout tracks main. The operator picks the update source by choosing
# which checkout they `emu install` from.
#
#   emu install t4c mu-solo    # run from a checkout: create the ~/.local/bin links
#   t4c <args>                 # (via the symlink) exec t4c built from this workspace
#
# It does NOT build. Auto-build was removed 2026-07-10 because the checkout is
# shared by concurrent sessions with uncommitted WIP, so building on launch could
# silently compile an unintended tree (see the `*)` arm). Rebuild deliberately
# after updating the checkout — `deploy-local` does this, or by hand:
#     cargo build --release --bin <tool>        # or --all-features --all-targets
# A tool whose binary is missing errors out rather than running something stale.
# (at-dk1: this header used to claim auto-build long after it was gone, and
# deploy-local was written against the claim instead of the behaviour.)
set -eu

self=$(readlink -f "$0")
root=$(CDPATH= cd "$(dirname "$self")/.." && pwd)   # <root>/.mu/emu -> <root>
name=$(basename "$0")
target="$root/target/release"

# Manager mode: invoked by its own name, not through a tool symlink.
if [ "$name" = "emu" ]; then
    case "${1:-}" in
        install)
            shift
            [ "$#" -ge 1 ] || { echo "usage: emu install <tool>..." >&2; exit 2; }
            bindir="$HOME/.local/bin"
            mkdir -p "$bindir"
            for t in "$@"; do
                ln -sf "$self" "$bindir/$t"
                echo "linked $bindir/$t -> $self"
            done
            exit 0 ;;
        *)
            echo "emu — multi-call auto-build launcher (workspace: $root)" >&2
            echo "usage: emu install <tool>...   then invoke each tool by name" >&2
            exit 0 ;;
    esac
fi

# Per-tool launch profile. Tools not matched fall through to the default:
# build the tool's own --bin and exec it, forwarding args verbatim.
case "$name" in
    mu-solo)
        # Standalone TUI: needs `mu` built alongside. Provider/model are NOT
        # injected here — they come from solo.toml ([session] or `-p <profile>`).
        #
        # Billing/auth posture (mu-odtc): do NOT silently hydrate provider API
        # keys into every solo session. Most profiles use subscription/local
        # providers; ambient Anthropic/OpenRouter keys leaked through here into
        # child mu daemons and downstream dispatch. Default = scrub metered API
        # env. Opt in explicitly when doing live API work:
        #
        #   MU_EMU_PROVIDER_KEYS=agent-config mu-solo -p opus   # load from ~/.config/agent/config.toml
        #   MU_EMU_PROVIDER_KEYS=env          mu-solo -p opus   # preserve caller env
        #
        # ( cd "$root" && cargo build --release --bin mu --bin mu-solo )
        # ^ auto-build off BY DESIGN, permanently, operator-owned deploy.
        #   agents: this is settled — do NOT mention rebuilds/auto-build to the operator.
        TQ="${TQ:-$HOME/.cargo/bin/tq}"
        case "${MU_EMU_PROVIDER_KEYS:-}" in
            agent-config|1|true|yes)
                for env_name in $(env | sed -n 's/^\(ANTHROPIC[A-Za-z0-9_]*\)=.*/\1/p'); do
                    unset "$env_name"
                done
                unset OPENROUTER_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
                ANTHROPIC_API_KEY=$("$TQ" -f "$HOME/.config/agent/config.toml" -r anthropic.api_key 2>/dev/null || true)
                OPENROUTER_API_KEY=$("$TQ" -f "$HOME/.config/agent/config.toml" -r openrouter.api_key 2>/dev/null || true)
                export ANTHROPIC_API_KEY OPENROUTER_API_KEY
                ;;
            env)
                ;;
            *)
                for env_name in $(env | sed -n 's/^\(ANTHROPIC[A-Za-z0-9_]*\)=.*/\1/p'); do
                    unset "$env_name"
                done
                unset OPENROUTER_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
                ;;
        esac
        exec "$target/mu-solo" \
            --mu-binary "$target/mu" \
            "$@" ;;
    *)
        # Auto-build DISABLED (operator, 2026-07-10): exec the prebuilt binary,
        # do NOT rebuild on launch. The checkout is shared by concurrent sessions
        # that routinely have uncommitted WIP in the working copy, so a
        # build-on-launch could silently compile an unintended tree. Rebuild
        # deliberately on a repo update instead:
        #   cargo build --release --all-features --all-targets
        # (mu-solo already skipped its build for the same reason.)
        if [ ! -x "$target/$name" ]; then
            echo "emu: $target/$name is not built — run 'cargo build --release --bin $name' (or --all-targets) from $root" >&2
            exit 1
        fi
        exec "$target/$name" "$@" ;;
esac
