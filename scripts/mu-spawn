#!/bin/sh
# mu-spawn — launch a non-POT worker agent.
#
# Current contract (mu-ktj0 / mu-lqa0): POTs/jails are gone. This wrapper is
# the small, boring dispatch surface used by mu's spawn_worker path and by
# humans who want an ad-hoc child agent. It selects a provider/model through
# scripts/agent-role (unless explicitly overridden), then dispatches through
# scripts/lib/agent-dispatch.sh so worker launches share the same ollama lease
# and capability/tool-grant semantics as ai-review/orchestrator.
#
# Usage:
#   mu-spawn [options] [prompt...]
#   echo "task" | mu-spawn --session-id session-9 --daemon-id d1
#
# Options:
#   --role ROLE          agent_roles.toml role to resolve (default: coding)
#   --rank N            role rank, 0-based (default: 0)
#   --provider P        provider override (skips role provider)
#   --model M           model override (skips role model)
#   --session-id ID     spawned worker session id (default: env MU_SESSION_ID)
#   --daemon-id ID      daemon id for dialogue identity (default: env MU_DAEMON_ID)
#   --reply-to ID       parent session id (default: env MU_REPLY_TO)
#   --cwd DIR           working directory for the child (default: cwd)
#   --timeout SECS      wall-clock timeout (default: env MU_SPAWN_TIMEOUT or 3600)
#   --tools CSV         child tool grant (default: env MU_SPAWN_TOOLS or read,grep)
#   --mcp-config FILE   claude MCP config file (default: env MU_SPAWN_MCP_CONFIG)
#   --dry-run           print the resolved command and exit
#   -h, --help          show this help
#
# Prompt is read from argv when present, otherwise stdin. The child is told its
# mcp-dialogue peer id, which is mu:<daemon_id>:<session_id> when both pieces are
# known. mu-native sessions bind dialogue_say/dialogue_poll identity in the tool
# layer; claude workers get this as prompt guidance and can use an MCP config if
# supplied.
set -eu

usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }
die() { printf 'mu-spawn: %s\n' "$1" >&2; exit 2; }
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\''/g")"; }

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
AGENT_ROLE=${AGENT_ROLE:-$SCRIPT_DIR/agent-role}
AGENT_DISPATCH_LIB=${AGENT_DISPATCH_LIB:-$SCRIPT_DIR/lib/agent-dispatch.sh}
ROLE=coding
RANK=0
RANK_SET=0
PROVIDER=${MU_SPAWN_PROVIDER:-}
MODEL=${MU_SPAWN_MODEL:-}
SESSION_ID=${MU_SESSION_ID:-}
DAEMON_ID=${MU_DAEMON_ID:-}
REPLY_TO=${MU_REPLY_TO:-}
CWD=$(pwd)
TIMEOUT_SECS=${MU_SPAWN_TIMEOUT:-3600}
MCP_CONFIG=${MU_SPAWN_MCP_CONFIG:-}
if [ "${MU_SPAWN_TOOLS+x}" ]; then
  SPAWN_TOOLS=$MU_SPAWN_TOOLS
else
  SPAWN_TOOLS=read,grep
fi
MU_BIN=${MU:-mu}
DRY_RUN=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --role) ROLE=${2:?--role needs a value}; shift 2 ;;
    --rank) RANK=${2:?--rank needs a value}; RANK_SET=1; shift 2 ;;
    --provider) PROVIDER=${2:?--provider needs a value}; shift 2 ;;
    --model) MODEL=${2:?--model needs a value}; shift 2 ;;
    --session-id) SESSION_ID=${2:?--session-id needs a value}; shift 2 ;;
    --daemon-id) DAEMON_ID=${2:?--daemon-id needs a value}; shift 2 ;;
    --reply-to) REPLY_TO=${2:?--reply-to needs a value}; shift 2 ;;
    --cwd) CWD=${2:?--cwd needs a value}; shift 2 ;;
    --timeout) TIMEOUT_SECS=${2:?--timeout needs a value}; shift 2 ;;
    --tools) SPAWN_TOOLS=${2:?--tools needs a value}; shift 2 ;;
    --mcp-config) MCP_CONFIG=${2:?--mcp-config needs a value}; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
done

# Seat selection (mu-hqr6). A PINNED seat — any of --provider/--model (or
# their env defaults) or an explicit --rank — resolves to exactly one target
# and dispatches once, no fallback: the caller asked for that seat. Otherwise
# TARGETS holds the role's FULL ranking (one "provider model" per line) and
# dispatch walks it top-down: a seat exiting 75 (EX_TEMPFAIL — agent-dispatch's
# "unusable in this environment": missing binary,
# held/unreachable ollama box, a lane out of tokens) is skipped with a note and
# the next rank runs; the seat that answered is named when any were skipped.
# Any other exit code is a real result and propagates immediately — fallback
# never re-runs a task on a different model after a genuine failure.
# mu-cbmru: the one exception is a worker chosen from a role whose mu lane ran
# out of tokens (exit 4 — after the session's in-place walk of the role when
# it could make one; it cannot once output has streamed, or without --role).
# That task starts over from the role's first rank, skipping ranks this worker
# already dispatched, and the restarted worker is TOLD it is a restart — a
# pinned `--rank N` seat included, since it too was chosen from the role.
# mu-s3uae: a claude-oauth rank chosen from a role that does not return
# success (`claude -p` has no exit code for its usage limit, so capped and
# failed are not told apart) takes the same start-over, without the
# out-of-tokens label.
# mu-049: a model named outright (--provider/--model) was not chosen from the
# role, so the session gets no role to fall back through; a role (with or
# without --rank) passes its name down.
if [ -n "$PROVIDER" ] || [ -n "$MODEL" ]; then EXPLICIT_MODEL=1; else EXPLICIT_MODEL=0; fi
if [ -n "$PROVIDER" ] || [ -n "$MODEL" ] || [ "$RANK_SET" -eq 1 ]; then
  if [ -z "$PROVIDER" ] || [ -z "$MODEL" ]; then
    [ -x "$AGENT_ROLE" ] || die "agent-role not executable at $AGENT_ROLE"
    role_line=$($AGENT_ROLE "$ROLE" "$RANK") || exit $?
    role_provider=$(printf '%s\n' "$role_line" | awk 'NR==1 {print $1}')
    role_model=$(printf '%s\n' "$role_line" | awk 'NR==1 {$1=""; sub(/^ /, ""); print}')
    [ -n "$role_provider" ] && [ -n "$role_model" ] || die "agent-role returned no provider/model for $ROLE rank $RANK"
    [ -n "$PROVIDER" ] || PROVIDER=$role_provider
    [ -n "$MODEL" ] || MODEL=$role_model
  fi
  TARGETS="$PROVIDER $MODEL"
  PINNED=1
else
  [ -x "$AGENT_ROLE" ] || die "agent-role not executable at $AGENT_ROLE"
  TARGETS=$($AGENT_ROLE "$ROLE") || exit $?
  [ -n "$TARGETS" ] || die "agent-role returned no targets for role $ROLE"
  PINNED=0
fi

PROMPT_FILE=$(mktemp "${TMPDIR:-/tmp}/mu-spawn.prompt.XXXXXX")
SYS_FILE=$(mktemp "${TMPDIR:-/tmp}/mu-spawn.system.XXXXXX")
RESTART_PROMPT=""
trap 'rm -f "$PROMPT_FILE" "$SYS_FILE" ${RESTART_PROMPT:+"$RESTART_PROMPT"}' EXIT INT TERM

if [ "$#" -gt 0 ]; then
  printf '%s\n' "$*" > "$PROMPT_FILE"
else
  cat > "$PROMPT_FILE"
fi

PEER_ID=""
if [ -n "$DAEMON_ID" ] && [ -n "$SESSION_ID" ]; then
  PEER_ID="mu:$DAEMON_ID:$SESSION_ID"
fi

cat > "$SYS_FILE" <<EOF
You are a spawned worker agent. Execute the user's task and print a concise result.

Worker identity:
- daemon_id: ${DAEMON_ID:-unknown}
- session_id: ${SESSION_ID:-unknown}
- dialogue peer id: ${PEER_ID:-unknown}
- reply_to session: ${REPLY_TO:-unknown}

If mcp-dialogue tools are available, register presence before work by polling your own inbox once (dialogue_poll with a short timeout is enough). Use peer id '${PEER_ID:-unknown}'. For mu-native dialogue_say, the 'from' field is bound automatically by the runtime; do not spoof it. If you need to notify the parent and know its peer id, send a short result there as well as printing stdout. If dialogue tools are unavailable, stdout is the fallback result channel.
EOF

[ -r "$AGENT_DISPATCH_LIB" ] || die "agent-dispatch.sh not readable at $AGENT_DISPATCH_LIB"
# shellcheck source=scripts/lib/agent-dispatch.sh
. "$AGENT_DISPATCH_LIB"

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "$TARGETS" | while IFS= read -r target; do
    [ -n "$target" ] || continue
    printf 'cd %s && TOOLS=%s TIMEOUT=%s MAX_TURNS=%s MU=%s SYSPROMPT=%s MCP_CONFIG=%s agent_dispatch %s %s %s\n' \
      "$(q "$CWD")" "$(q "$SPAWN_TOOLS")" "$(q "$TIMEOUT_SECS")" \
      "$(q "${MU_SPAWN_MAX_TURNS:-40}")" "$(q "$MU_BIN")" "$(q "$SYS_FILE")" \
      "$(q "$MCP_CONFIG")" "$(q "${target%% *}")" "$(q "${target#* }")" "$(q "$PROMPT_FILE")"
  done
  exit 0
fi

cd "$CWD"

# Share the same dispatch/lease/capability path as ai-review/orchestrator.
TOOLS=$SPAWN_TOOLS
SYSPROMPT=$SYS_FILE

# mu-cbmru: out of tokens, a worker keeps going. Within the session, the
# daemon walks the role's ranks in place; when that walk gives up (exit 4),
# the walk below starts the task over from the role's first rank (operator,
# 2026-09-28), saying so, since the first attempt may already have acted.
# AGENT_DISPATCH_CAP_ROUTE_AROUND=1 still converts a capped read-only seat's
# 4 into 75 in agent-dispatch, which the walk treats as "fall to next rank".
out_of_tokens=""
# cleared, not left alone, for a model named outright: a caller's exported
# DISPATCH_ROLE must not arm a fallback onto another model
if [ "$EXPLICIT_MODEL" -eq 1 ]; then DISPATCH_ROLE=""; else DISPATCH_ROLE=$ROLE; fi
# agent-dispatch's own default, named here because the dispatcher's copy is
# local to it and its out-of-tokens marker sits beside this file.
ERRLOG=${ERRLOG:-${TMPDIR:-/tmp}/agent-dispatch.$$.err}
TOKENS_MARKER="${ERRLOG%.err}.out-of-tokens"
TIMEOUT=$TIMEOUT_SECS
MAX_TURNS=${MU_SPAWN_MAX_TURNS:-40}
MU=$MU_BIN
MCP_CONFIG=$MCP_CONFIG
export TOOLS SYSPROMPT TIMEOUT MAX_TURNS MU MCP_CONFIG

# Walk the seat list (see walk() below). Newline iteration: targets are
# "provider model" lines.
skipped=""
tried=""      # "provider model" lines already dispatched by this worker
ran_dry=0     # some rank this worker dispatched ran out of tokens (exit 4)
ran_failed=0  # a claude-oauth rank ran and did not return success (mu-s3uae)
failed_rc=1   # ... and this was its code: the result when no other rank answers
tokens_note() {
  printf 'mu-spawn: out of tokens: %s. The account behind that lane has no credit or hit its usage cap; the operator needs to add credit to use it again (a subscription cap resets on its own).\n' \
    "$out_of_tokens" >&2
}
is_tried() {  # $1="provider model"
  case "
$tried
" in *"
$1
"*) return 0 ;; esac
  return 1
}

# walk <targets> <restart?>: dispatch each untried "provider model" line in
# order. Exit 75 falls to the next rank. Exit 4 from a role-armed mu lane (it
# ran out of tokens) returns 4 on the first walk, so the caller starts over;
# on the restart walk it just falls on. A claude-oauth rank that did not
# return success (any code but 0, 75, 124) returns 70 on the first walk —
# same start-over, without the out-of-tokens label — and falls on during the
# restart (mu-s3uae). Any other code is the worker's real result: the process
# exits with it.
# Returns 75 when the list is used up.
restart_why=""   # set by walk() for the start-over line and the restart notice
walk() {
  walk_restart=$2
  walk_rank=0
  OLD_IFS=$IFS
  IFS='
'
  for target in $1; do
    IFS=$OLD_IFS
    [ -n "$target" ] || { IFS='
'; continue; }
    if is_tried "$target"; then
      walk_rank=$((walk_rank + 1)); IFS='
'; continue
    fi
    tried="${tried:+$tried
}$target"
    SEAT_PROVIDER=${target%% *}
    SEAT_MODEL=${target#* }
    printf '[mu-spawn] provider=%s model=%s role=%s rank=%s tools=%s session=%s peer=%s\n' \
      "$SEAT_PROVIDER" "$SEAT_MODEL" "$ROLE" "$walk_rank" "${SPAWN_TOOLS:-<none>}" \
      "${SESSION_ID:-unknown}" "${PEER_ID:-unknown}" >&2
    rc=0
    agent_dispatch "$SEAT_PROVIDER" "$SEAT_MODEL" "$WALK_PROMPT" || rc=$?
    # mu-s3uae: a claude-oauth rank that did not return success goes the same
    # way as a mu lane out of tokens: on the first walk the task starts over
    # from the role's first rank, and the restarted worker is TOLD the earlier
    # attempt may have acted (the replay the operator accepted for this
    # script, 2026-09-28); on the restart walk it falls to the next rank.
    # `claude -p` has no exit code for a usage limit, only prose, so "capped"
    # is not read from it: failed is failed, and it is not counted as out of
    # tokens (no add-credit note). 124 is a timeout and stays the result; 75
    # is agent-dispatch's own skip (no claude binary on PATH) and is handled
    # below like any other seat that never ran.
    if [ "$SEAT_PROVIDER" = "claude-oauth" ] && [ -n "${DISPATCH_ROLE:-}" ] &&
       [ "$rc" -ne 0 ] && [ "$rc" -ne 75 ] && [ "$rc" -ne 124 ]; then
      restart_why="did not return success (exit $rc)"
      ran_failed=1; failed_rc=$rc
      skipped="${skipped:+$skipped, }$SEAT_PROVIDER/$SEAT_MODEL (exit $rc)"
      if [ "$walk_restart" -eq 0 ]; then
        IFS=$OLD_IFS
        return 70
      fi
      printf 'mu-spawn: %s/%s did not return success (exit %s; its stderr is in %s); the next rank takes the task\n' \
        "$SEAT_PROVIDER" "$SEAT_MODEL" "$rc" "$ERRLOG" >&2
      walk_rank=$((walk_rank + 1)); IFS='
'; continue
    fi
    # exit 4 from a MU lane is mu's own "out of tokens" (after whatever
    # in-session walk the role armed)
    if [ "$rc" -eq 4 ] && [ -n "${DISPATCH_ROLE:-}" ] && [ "$SEAT_PROVIDER" != "claude-oauth" ]; then
      restart_why="ran out of tokens"
      ran_dry=1
      out_of_tokens="${out_of_tokens:+$out_of_tokens, }$SEAT_PROVIDER/$SEAT_MODEL"
      skipped="${skipped:+$skipped, }$SEAT_PROVIDER/$SEAT_MODEL (out of tokens)"
      if [ "$walk_restart" -eq 0 ]; then
        IFS=$OLD_IFS
        return 4
      fi
      walk_rank=$((walk_rank + 1)); IFS='
'; continue
    fi
    if [ "$rc" -eq 75 ]; then
      if [ "$PINNED" -eq 1 ] && [ "$walk_restart" -eq 0 ]; then
        printf 'mu-spawn: pinned seat %s/%s unusable in this environment (exit 75); no fallback for a pinned seat\n' \
          "$SEAT_PROVIDER" "$SEAT_MODEL" >&2
        exit 75
      fi
      # agent-dispatch leaves this marker beside its errlog for an
      # out-of-tokens skip; its existence, not any output text, says why.
      why="unusable in this environment"
      if [ -e "$TOKENS_MARKER" ]; then
        why="out of tokens"
        out_of_tokens="${out_of_tokens:+$out_of_tokens, }$SEAT_PROVIDER/$SEAT_MODEL"
        rm -f "$TOKENS_MARKER"
      fi
      printf 'mu-spawn: seat %s/%s (rank %s) %s; falling to next rank\n' \
        "$SEAT_PROVIDER" "$SEAT_MODEL" "$walk_rank" "$why" >&2
      skipped="${skipped:+$skipped, }$SEAT_PROVIDER/$SEAT_MODEL ($why)"
      walk_rank=$((walk_rank + 1)); IFS='
'; continue
    fi
    if [ -n "$skipped" ]; then
      printf 'mu-spawn: this worker ran on %s/%s (rank %s) after skipping: %s\n' \
        "$SEAT_PROVIDER" "$SEAT_MODEL" "$walk_rank" "$skipped" >&2
    fi
    [ -z "$out_of_tokens" ] || tokens_note
    exit "$rc"
  done
  IFS=$OLD_IFS
  return 75
}

WALK_PROMPT=$PROMPT_FILE   # what walk() dispatches; a restart swaps in its own
rc=0
walk "$TARGETS" 0 || rc=$?
if [ "$rc" -eq 4 ] || [ "$rc" -eq 70 ]; then
  # Operator, 2026-09-28: when a worker's lane runs out of tokens (and the
  # session's in-place walk, if the role armed one, found nothing either),
  # or a claude rank did not return success (mu-s3uae, exit 70 from walk),
  # the task starts over on the role's FIRST rank — whatever that rank is (a
  # claude rank runs as `claude -p`, like any dispatch of it). Ranks this
  # worker already DISPATCHED are skipped. A rank the session only walked
  # through in place is not known here, so it may be tried again and run out
  # again at once — one refused request each, bounded by the roster. The
  # first attempt may already have made changes; the restart runs anyway,
  # and says so.
  printf 'mu-spawn: %s/%s (role %s) %s; starting the task over from the role'"'"'s first rank (the first attempt may already have made changes; its stderr is in %s)\n' \
    "$SEAT_PROVIDER" "$SEAT_MODEL" "$ROLE" "$restart_why" "$ERRLOG" >&2
  # the roster is resolved again, and a failure to resolve it is ITS failure —
  # reported as such, never folded into "every rank ran out"
  role_rc=0
  ROLE_TARGETS=$($AGENT_ROLE "$ROLE") || role_rc=$?
  if [ "$role_rc" -ne 0 ] || [ -z "$ROLE_TARGETS" ]; then
    printf 'mu-spawn: could not resolve role %s to start over (%s exit %s, %s); the task is NOT restarted\n' \
      "$ROLE" "$AGENT_ROLE" "$role_rc" "$([ "$role_rc" -ne 0 ] && echo 'resolver failed' || echo 'no ranks')" >&2
    [ -z "$out_of_tokens" ] || tokens_note
    exit 2
  fi
  # the restarted worker is told it is one: the earlier attempt may already
  # have acted, and it is the worker — reading the state — that can tell
  # what is done and what is left
  RESTART_PROMPT=$(mktemp "${TMPDIR:-/tmp}/mu-spawn.restart.XXXXXX")
  {
    printf '[mu-spawn] This is a RESTART of this task. An earlier attempt on %s/%s %s partway through and may already have made changes (edited files, sent messages, spawned workers). Check the current state before repeating any action: finish what is left, do not redo what is done.\n\n' \
      "$SEAT_PROVIDER" "$SEAT_MODEL" "$restart_why"
    cat "$PROMPT_FILE"
  } > "$RESTART_PROMPT"
  WALK_PROMPT=$RESTART_PROMPT
  rc=0
  walk "$ROLE_TARGETS" 1 || rc=$?
fi

printf 'mu-spawn: no usable seat for role %s in this environment (skipped: %s)\n' \
  "$ROLE" "${skipped:-none}" >&2
[ -z "$out_of_tokens" ] || tokens_note
# a rank ran and ran out of tokens: say so with 4, not "never ran" (75)
[ "$ran_dry" -eq 1 ] && exit 4
# mu-s3uae: a claude rank ran and failed, and no other rank answered: that
# failure is the result (its own code, possibly after it acted), not "never
# ran" (75) — a caller must not read an executed failure as no seat.
if [ "$ran_failed" -eq 1 ]; then
  printf 'mu-spawn: a claude-oauth rank ran and did not return success (exit %s; its stderr is in %s) and no other rank answered; that is the result\n' \
    "$failed_rc" "$ERRLOG" >&2
  exit "$failed_rc"
fi
exit 75
